# Local-only defaults. Replace every public shop value before production seed/deploy.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=public/uploads
SHOP_ID=shop-main
SHOP_SLUG=metsanilo
SHOP_NAME_FI=
SHOP_NAME_EN=
SHOP_TIMEZONE=Europe/Helsinki
PICKUP_NAME_FI=
PICKUP_NAME_EN=
PICKUP_ADDRESS=
PICKUP_INSTRUCTIONS_FI=
PICKUP_INSTRUCTIONS_EN=
PICKUP_TIME=20:00
CONTACT_PHONE=
CONTACT_EMAIL=
CONTACT_HOURS=
BOOTSTRAP_ADMIN_EMAIL=tuandeveloper@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Shop Admin
BETTER_AUTH_SECRET=
# Origin only; the Better Auth route is /api/auth/better.
BETTER_AUTH_URL=http://localhost:3000

# Production/operator-only cutover inputs. Never commit real values.
RELEASE_PREFLIGHT=false
RELEASE_SHA=
RELEASE_COMMIT_SHA=
AUTH_CUTOVER_BASE_URL=
ADMIN_BOOTSTRAP_USERNAME=
AUTH_CUTOVER_CANARY_PASSWORD=
AUTH_CUTOVER_CANARY_FINAL_PASSWORD=

# Seed and backup operator flags. Leave unset for routine local development.
SEED_ALLOW_EXISTING=
SEED_DRY_RUN=
TURSO_BACKUP_GROUP=

# Smoke testing configuration (optional)
AUTH_SMOKE_BASE_URL=
AUTH_SMOKE_ALLOW_PRODUCTION=false
AUTH_SMOKE_ADMIN_EMAIL=
AUTH_SMOKE_ADMIN_PASSWORD=
AUTH_SMOKE_MANAGER_EMAIL=
AUTH_SMOKE_MANAGER_PASSWORD=

# Seed-only product inputs (integer cents and millilitres).
SEED_PRODUCT_CODE=
SEED_PRODUCT_NAME_FI=
SEED_PRODUCT_NAME_EN=
SEED_PACKAGE_LABEL_FI=
SEED_PACKAGE_LABEL_EN=
SEED_PACKAGE_ML=
SEED_PACKAGE_PRICE_CENTS=
SEED_AVAILABLE_FROM=
SEED_AVAILABLE_THROUGH=
SEED_DAILY_CAPACITY_ML=
